    {
      "name": "agentic-retro",
      "source": {
        "source": "npm",
        "package": "agentic-retro",
        "version": "latest"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Productivity"
    }
  ]
